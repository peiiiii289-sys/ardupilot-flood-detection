<?xml version="1.0"?>
<mavlink>
  <enums>
    <enum name="MAV_COMPONENT">
      <entry value="211" name="MAV_COMP_ID_UNICO_AI_COMPUTER">
        <description>AI computer component</description>
      </entry>
    </enum>

    <enum name="AI_LANDING_FRAME">
      <entry value="200" name="AI_LANDING_FRAME_CAMERA_FRD">
        <description>Camera FRD frame</description>
      </entry>
    </enum>
  </enums>

  <messages>
    <message id="52100" name="AI_LANDING_CORRECTION">
      <description>AI landing correction from AI module to flight controller</description>
      <field type="uint32_t" name="time_boot_ms">Timestamp since AI boot</field>
      <field type="float" name="roll_err">Roll correction in rad</field>
      <field type="float" name="pitch_err">Pitch correction in rad</field>
      <field type="float" name="yaw_err">Yaw correction in rad</field>
      <field type="float" name="x_err">Forward/backward error in m</field>
      <field type="float" name="y_err">Right/left error in m</field>
      <field type="float" name="z_err">Down/up error in m</field>
      <field type="float" name="distance">Distance to landing point in m</field>
      <field type="float" name="confidence">0-1 confidence</field>
      <field type="uint8_t" name="frame">AI_LANDING_FRAME</field>
      <field type="uint8_t" name="flags">bit0=yaw_valid bit1=distance_valid</field>
    </message>

    <message id="52102" name="AI_LANDING_STATUS">
      <description>AI landing health/status from AI module to flight controller</description>
      <field type="uint32_t" name="time_boot_ms">Timestamp since AI boot</field>
      <field type="float" name="visual_confidence">0-1 confidence</field>
      <field type="uint8_t" name="target_lost">1 if target lost</field>
      <field type="float" name="reproj_error">Reprojection error</field>
      <field type="float" name="covariance">Pose covariance</field>
    </message>

    <message id="52101" name="AI_FLOOD_DETECTION_RESULT">
      <description>Flood and waterlogging detection summary result</description>
      <field type="uint32_t" name="time_boot_ms">Timestamp since AI boot (ms)</field>
      <field type="uint16_t" name="image_width">Image width in pixels</field>
      <field type="uint16_t" name="image_height">Image height in pixels</field>
      <field type="float" name="water_coverage_pct">Water coverage percentage of full image (0-100)</field>
      <field type="float" name="road_water_pct">Water coverage percentage of road region (0-100)</field>
      <field type="uint8_t" name="flood_level">Flood level: 0=none, 1=low, 2=medium, 3=high</field>
      <field type="float" name="confidence">Flood detection confidence (0-1)</field>
      <field type="float" name="inference_fps">Inference FPS</field>
    </message>
  </messages>
</mavlink>